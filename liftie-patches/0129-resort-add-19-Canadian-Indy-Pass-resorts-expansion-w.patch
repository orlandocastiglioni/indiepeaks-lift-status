+import records from './warmup.js';
+
+// HBM publishes no per-run open/closed set. The only discrete trail-level
+// items are the two TerrainParkTTT records (Rotary Trail To Town, Local
+// Terrain Park). status = liftStatus1 (coerced by the shared trail collector);
+// the terrain park record is tagged level terrainPark.
+export default function parse(dom) {
+  const rows = [];
+  for (const r of records(dom, 'TerrainParkTTT')) {
+    const name = r.title_fld?.trim();
+    if (!name) {
+      continue;
+    }
+    rows.push({
+      name,
+      status: r.liftStatus1,
+      level: /terrain park/i.test(name) ? 'terrainPark' : undefined
+    });
+  }
+  return rows;
+}
diff --git a/lib/resorts/hudson-bay-mountain/warmup.js b/lib/resorts/hudson-bay-mountain/warmup.js
new file mode 100644
index 00000000..c34e1e2d
--- /dev/null
+++ b/lib/resorts/hudson-bay-mountain/warmup.js
@@ -0,0 +1,17 @@
+import select from '../../select.js';
+import { allText } from '../../tools/domutil.js';
+
+// The Wix snow-report page server-renders every report field as one JSON blob
+// in <script type="application/json" id="wix-warmup-data">. Content collections
+// live under appsWarmupData.dataBinding.dataStore.recordsByCollectionId, keyed
+// by collection id (HBMLiftStatus for lifts, TerrainParkTTT for the trail/park
+// items); each collection is an object of { recordId: record }.
+export default function records(dom, collection) {
+  const script = select(dom, 'script#wix-warmup-data')[0];
+  if (!script) {
+    return [];
+  }
+  const data = JSON.parse(allText(script) || '{}');
+  const store = data?.appsWarmupData?.dataBinding?.dataStore?.recordsByCollectionId ?? {};
+  return Object.values(store[collection] ?? {});
+}
diff --git a/lib/resorts/marble-mountain/index.js b/lib/resorts/marble-mountain/index.js
new file mode 100644
index 00000000..45978798
--- /dev/null
+++ b/lib/resorts/marble-mountain/index.js
@@ -0,0 +1,33 @@
+import select from '../../select.js';
+import coerce from '../../tools/coerce.js';
+import { allText } from '../../tools/domutil.js';
+
+// Marble Mountain publishes lift + trail status as WordPress "Ninja Tables"
+// server-rendered on /terrain-status/. There are four single-cell "lift status"
+// tables, each identified by a header column classed `ninja_clmn_nm_lift`; the
+// stat-tile summary tables at the top use different column classes and are
+// skipped. The one data <td> reads "Lift Name <dash> STATUS" - usually a
+// U+2013 en-dash, but the Lightning Express cell uses a plain hyphen - so we
+// split on the last dash of any kind. Status vocab is OPEN / CLOSED, both of
+// which coerce cleanly.
+export default function parse(dom) {
+  const lifts = {};
+  for (const table of select(dom, 'table')) {
+    if (select(table, 'th.ninja_clmn_nm_lift').length === 0) {
+      continue;
+    }
+    for (const td of select(table, 'tbody td')) {
+      const cell = allText(td).replace(/\s+/g, ' ').trim();
+      const idx = Math.max(cell.lastIndexOf('–'), cell.lastIndexOf('—'), cell.lastIndexOf('-'));
+      if (idx < 0) {
+        continue;
+      }
+      const name = cell.slice(0, idx).trim();
+      const status = cell.slice(idx + 1).trim();
+      if (name) {
+        lifts[name] = coerce(status);
+      }
+    }
+  }
+  return lifts;
+}
