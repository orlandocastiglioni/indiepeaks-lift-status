index 00000000..cb6e26f0
--- /dev/null
+++ b/lib/resorts/mont-sutton/trails.js
@@ -0,0 +1,44 @@
+import select from '../../select.js';
+import { findText } from '../../tools/domutil.js';
+
+// Trail table table#pistes > tbody; one row per trail section (top/bottom of a
+// trail appear as separate rows). td[1] is the name, td[2] holds one or more
+// <span class="icon icon_track-XXX"> DIFFICULTY icons and td[4] the OPENING
+// status. Both status and difficulty must be read from the CSS class, not the
+// text: liftie's default levels map mis-rates Sutton's French vocabulary and the
+// French status text is Latin-1 mojibake. Difficulty is mapped by icon class
+// (icon_track-* -> liftie level); pick the hardest when a row lists two. The
+// td[4] class token (open/closed) is already known to coerce downstream.
+const LEVELS = {
+  'icon_track-easy': 'green',
+  'icon_track-hard': 'blue',
+  'icon_track-very-hard': 'black',
+  'icon_track-extreme': 'doubleBlack',
+  'icon_track-extreme-plus': 'doubleBlack'
+};
+const RANK = { green: 0, blue: 1, black: 2, doubleBlack: 3 };
+
+export default function parse(dom) {
+  const rows = [];
+  for (const tr of select(dom, 'table#pistes tbody tr')) {
+    const tds = select(tr, 'td');
+    if (tds.length < 5) {
+      continue;
+    }
+    const name = findText(tds[1])?.trim();
+    if (!name) {
+      continue;
+    }
+    let level;
+    for (const span of select(tds[2], 'span')) {
+      for (const cls of (span.attribs?.class || '').split(/\s+/)) {
+        const mapped = LEVELS[cls];
+        if (mapped && (level === undefined || RANK[mapped] > RANK[level])) {
+          level = mapped;
+        }
+      }
+    }
+    rows.push({ name, status: (tds[4].attribs?.class || '').trim(), level });
+  }
+  return rows;
+}
diff --git a/lib/resorts/mt-washington-bc/index.js b/lib/resorts/mt-washington-bc/index.js
new file mode 100644
index 00000000..0ad5444d
--- /dev/null
+++ b/lib/resorts/mt-washington-bc/index.js
@@ -0,0 +1,31 @@
+import select from '../../select.js';
+import coerce from '../../tools/coerce.js';
+import { findText } from '../../tools/domutil.js';
+
+// Joomla / SP Page Builder lift report. Every lift is a
+// div.slope-grid-container.slope-grid-rows (the column-header row lacks
+// slope-grid-rows and is therefore excluded by the selector). The NAME is the
+// <a> in cell 1. STATUS is encoded ONLY by cell 1's FontAwesome icon:
+//   fa-check-square-o -> open, fa-window-close -> closed. The cell-2 TIME text
+// (e.g. "9:00 am - 3:30 pm") must NOT be coerced - it would fall through to
+// 'scheduled' - so status is derived from the icon class.
+export default function parse(dom) {
+  const status = {};
+  for (const row of select(dom, 'div.slope-grid-container.slope-grid-rows')) {
+    const name = findText(select(row, 'a')[0])?.trim();
+    if (!name) {
+      continue;
+    }
+    const cls = select(row, 'span.fa')[0]?.attribs?.class || '';
+    let token;
+    if (/\bfa-check-square-o\b/.test(cls)) {
+      token = 'open';
+    } else if (/\bfa-window-close\b/.test(cls)) {
+      token = 'closed';
+    }
+    if (token) {
+      status[name] = coerce(token);
+    }
+  }
+  return status;
+}
