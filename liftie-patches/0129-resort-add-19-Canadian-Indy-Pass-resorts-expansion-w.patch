@@ -0,0 +1,36 @@
+/**
+ * Same maneige.ski REST feed (station id 449) as the lifts, routed through
+ * flaresolverr; collect() in lib/trails/parse.js hands this parser the unwrapped
+ * JSON body. maneige gives ONLY aggregate open/total counts per trail category,
+ * never per-trail names or statuses, so we synthesize one summary row per
+ * category that exists (total > 0). open/closed is derived numerically and the
+ * fraction is kept in the row name.
+ *
+ * Level caveat (per recon): maneige's static difficulty inventory
+ * (trails_easy/hard/very_hard/extreme) uses Quebec semantics where 'hard' =
+ * intermediate, so those field names must NOT be fed through normalizeLevel;
+ * we don't use them for status at all. The only level we assert is terrainPark
+ * for the parks category, which is unambiguous.
+ */
+function push(rows, label, open, total, level) {
+  open = Number(open) || 0;
+  total = Number(total) || 0;
+  if (total > 0) {
+    const row = { name: `${label}: ${open}/${total} open`, status: open > 0 ? 'open' : 'closed' };
+    if (level) {
+      row.level = level;
+    }
+    rows.push(row);
+  }
+}
+
+export default function parse(data) {
+  const acf = data?.acf ?? {};
+  const rows = [];
+  push(rows, 'Trails (day)', acf.station_daytrails, acf.station_daytrails_total);
+  push(rows, 'Trails (night)', acf.station_nighttrails, acf.station_nighttrails_total);
+  push(rows, 'Glades', acf.station_sousbois, acf.station_sousbois_total);
+  push(rows, 'Terrain parks', acf.station_parks, acf.station_parks_total, 'terrainPark');
+  push(rows, 'Alpine touring', acf.alpine_trail_open, acf.alpine_trail_total);
+  return rows;
+}
diff --git a/lib/resorts/mont-sutton/index.js b/lib/resorts/mont-sutton/index.js
new file mode 100644
index 00000000..c1529c6d
--- /dev/null
+++ b/lib/resorts/mont-sutton/index.js
@@ -0,0 +1,26 @@
+import select from '../../select.js';
+import coerce from '../../tools/coerce.js';
+import { findText } from '../../tools/domutil.js';
+
+// Mont Sutton is a server-rendered WordPress page. The lift table lives in
+// div.lifts-conditions#lifts > table > tbody; the first row is a <th> header
+// (no <td>) and is skipped. td[0] is the chairlift number (used as the name).
+// STATUS comes from the status cell's CSS class token (ouvert/ferme, both known
+// to coerce) - never the visible French text, which is Latin-1-in-UTF-8 mojibake
+// ("Fermé" renders as garbage). We read the class of the class-bearing <td>.
+export default function parse(dom) {
+  const status = {};
+  for (const tr of select(dom, 'div.lifts-conditions#lifts tbody tr')) {
+    const tds = select(tr, 'td');
+    if (tds.length === 0) {
+      continue; // header row (<th> only)
+    }
+    const name = findText(tds[0])?.trim();
+    const cell = tds.find(td => td.attribs?.class) ?? tds[tds.length - 1];
+    const token = cell?.attribs?.class;
+    if (name && token) {
+      status[name] = coerce(token);
+    }
+  }
+  return status;
+}
