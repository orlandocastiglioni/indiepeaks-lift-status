diff --git a/lib/resorts/49-degrees-north/index.js b/lib/resorts/49-degrees-north/index.js
index a623a1c8..68061fd3 100644
--- a/lib/resorts/49-degrees-north/index.js
+++ b/lib/resorts/49-degrees-north/index.js
@@ -1,9 +1,12 @@
+// report rows (lifts and trails alike) are <h4>NAME - <span>STATUS</span></h4>
+// inside <section class="mountain-stats">; lift names carry a '#N' suffix
+// (Northern Spirit #1, ...), trail names do not
 export default {
-  selector: 'h4',
+  selector: 'section.mountain-stats h4',
   parse: {
     name: {
       child: 0,
-      fn: n => n.startsWith('Chair') && n.slice(0, -3)
+      fn: n => /#\d/.test(n) && n.replace(/\s*-\s*$/, '').trim()
     },
     status: 1
   }
