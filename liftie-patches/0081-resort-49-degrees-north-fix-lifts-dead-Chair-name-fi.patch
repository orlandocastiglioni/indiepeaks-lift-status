+<script>
+(function () {
+  const STORAGE_KEY = "cookieConsent_v1";
+  const wrap = document.getElementById("cc-wrap");
+  const btnAccept = document.getElementById("cc-accept");
+  const btnReject = document.getElementById("cc-reject");
+  const btnOpen = document.getElementById("cc-open-settings");
+  const backdrop = document.getElementById("cc-backdrop");
+  const btnSave = document.getElementById("cc-save");
+  const btnCancel = document.getElementById("cc-cancel");
+  const a = document.getElementById("cc-analytics");
+  const m = document.getElementById("cc-marketing");
+
+  // Show banner if no prior decision
+  const existing = safeParse(localStorage.getItem(STORAGE_KEY));
+  if (!existing) {showBar();}
+
+  // Buttons
+  btnAccept.addEventListener("click", () => {
+    saveConsent({ essential: true, analytics: true, marketing: true });
+    hideBar();
+  });
+
+  btnReject.addEventListener("click", () => {
+    saveConsent({ essential: true, analytics: false, marketing: false });
+    hideBar();
+  });
+
+  btnOpen.addEventListener("click", () => {
+    // Prefill dialog with existing or defaults
+    const c = safeParse(localStorage.getItem(STORAGE_KEY)) || { analytics: false, marketing: false };
+    a.checked = !!c.analytics;
+    m.checked = !!c.marketing;
+    openDialog();
+  });
+
+  btnSave.addEventListener("click", () => {
+    saveConsent({ essential: true, analytics: a.checked, marketing: m.checked });
+    closeDialog();
+    hideBar();
+  });
+
+  btnCancel.addEventListener("click", closeDialog);
+  backdrop.addEventListener("click", (e) => { if (e.target === backdrop) closeDialog(); });
+
+  function showBar(){wrap.classList.add("cc-show");}
+  function hideBar(){wrap.classList.remove("cc-show");}
+
+  function openDialog(){
+    backdrop.style.display="flex";
+    backdrop.setAttribute("aria-hidden","false");
+    // focus management
+    setTimeout(() => backdrop.querySelector(".cc-dialog").focus?.(), 0);
+  }
+  function closeDialog(){
+    backdrop.style.display="none";
+    backdrop.setAttribute("aria-hidden","true");
+  }
+
+  function saveConsent(obj){
+    localStorage.setItem(STORAGE_KEY, JSON.stringify({
+      ...obj,
+      timestamp: new Date().toISOString(),
+      version: 1
+    }));
+    // Example: run callbacks to load/remove scripts
+    applyConsent(obj);
+  }
+
+  function safeParse(s){ try{ return JSON.parse(s); }catch{ return null; } }
+
+  // Hook: apply consent to your scripts
+  function applyConsent(c){
+    // Example: load Google Analytics only if allowed
+    if (c.analytics) {
+      loadOnce("ga-loader", () => {
+        const g = document.createElement("script");
+        g.id = "ga-loader";
+        g.src = "https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID";
+        g.async = true;
+        document.head.appendChild(g);
+        window.dataLayer = window.dataLayer || [];
+        function gtag(){dataLayer.push(arguments);}
+        window.gtag = gtag;
+        gtag('js', new Date());
+        gtag('config', 'GA_MEASUREMENT_ID', { 'anonymize_ip': true });
+      });
+    } else {
+      // If previously loaded, you might want to disable/clear analytics cookies here
+    }
+
+    if (c.marketing) {
+      // Load your marketing pixel(s) here
+    }
+  }
+
+  function loadOnce(id, loader){
+    if (!document.getElementById(id)) loader();
+  }
+
+  // If consent already exists (e.g., user returns), apply it
+  if (existing) applyConsent(existing);
+})();
+</script>
