+
+  function markdownToHtml(text) {
+    if (!text) return "";
+    return text
+      .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g, '<a href="/$2" target="_blank" rel="noopener noreferrer">$1</a>')
+      .replace(/(^|\n)\s*[-*]\s+/g, '$1&bull; ')
+      .replace(/\n+/g, '<br>');
+  }
+
+function sanitizeHTML(input) {
+  const temp = document.createElement('div');
+  temp.innerHTML = input;
+
+  const allowedTags = ['A', 'BR'];
+  const walker = document.createTreeWalker(temp, NodeFilter.SHOW_ELEMENT, null, false);
+
+  while (walker.nextNode()) {
+    const el = walker.currentNode;
+
+    if (!allowedTags.includes(el.tagName)) {
+      el.replaceWith(...el.childNodes);
+      continue;
+    }
+
+    if (el.tagName === 'A') {
+      let href = el.getAttribute('href');
+
+      // ✅ Fix href="/https://..." (bad) → href="https://..."
+      if (href && href.startsWith('/https://')) {
+        href = href.slice(1);
+        el.setAttribute('href', href);
+      }
+
+      // ✅ Accept links starting with http or /
+      const isValidLink = href && (href.startsWith('http://') || href.startsWith('https://') || href.startsWith('/'));
+
+      if (!isValidLink) {
+        el.replaceWith(...el.childNodes); // Remove the <a> but keep text
+        continue;
+      }
+
+      // ✅ Keep only safe attributes
+      for (const attr of Array.from(el.attributes)) {
+        if (!['href', 'target', 'rel'].includes(attr.name)) {
+          el.removeAttribute(attr.name);
+        }
+      }
+
+      el.setAttribute('target', '_blank');
+      el.setAttribute('rel', 'noopener noreferrer');
+    }
+  }
+
+  return temp.innerHTML;
+}
+
+  window.sendMessage = async function () {
+    const message = inputField.value.trim();
+    if (!message) return;
+
+    chatLog.innerHTML += `<div class="user"><strong>You:</strong> ${message}</div>`;
+    inputField.value = "";
+
+    try {
+      const response = await fetch("/chatbot-handler.php", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ message })
+      });
+
+      const data = await response.json();
+
+      console.log("🔹 Raw API Reply:", data.reply);
+
+      const htmlConverted = markdownToHtml(data.reply);
+      console.log("🔹 After markdownToHtml:", htmlConverted);
+
+      const safeReply = sanitizeHTML(htmlConverted);
+      console.log("🔹 After sanitizeHTML:", safeReply);
+
+      chatLog.innerHTML += `<div class="bot"><strong>Washy:</strong> ${safeReply}</div>`;
+      chatLog.scrollTop = chatLog.scrollHeight;
+
+    } catch (err) {
+      console.error("❌ Chat error:", err);
+      chatLog.innerHTML += `<div class="bot"><strong>Washy:</strong> Sorry, something went wrong.</div>`;
+    }
+  };
