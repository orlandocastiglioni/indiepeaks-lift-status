diff --git a/lib/resorts/massif-du-sud/trails.js b/lib/resorts/massif-du-sud/trails.js
new file mode 100644
index 00000000..04f8442a
--- /dev/null
+++ b/lib/resorts/massif-du-sud/trails.js
@@ -0,0 +1,81 @@
+import select from '../../select.js';
+import { allText } from '../../tools/domutil.js';
+
+// Site difficulty enum -> liftie level. normalizeLevel already resolves easy,
+// difficult and extreme; very_difficult is unknown to it, so map every token
+// explicitly here. difficult and very_difficult both land on black (extreme
+// stays the sole doubleBlack tier) - see the resort summary for the rationale.
+const LEVELS = {
+  easy: 'green',
+  difficult: 'black',
+  very_difficult: 'black',
+  extreme: 'doubleBlack'
+};
+
+// Concatenate the Next.js app-router flight chunks (self.__next_f.push([1,"..."]))
+// and pull out the balanced "slopeSector":[...] array embedded in them.
+function slopeSectors(dom) {
+  let buf = '';
+  for (const script of select(dom, 'script')) {
+    const text = allText(script);
+    if (!text.includes('__next_f')) {
+      continue;
+    }
+    const re = /self\.__next_f\.push\(\[1,\s*"((?:[^"\\]|\\.)*)"\]\)/g;
+    let m;
+    while ((m = re.exec(text))) {
+      try {
+        buf += JSON.parse(`"${m[1]}"`);
+      } catch {
+        /* skip unparseable chunk */
+      }
+    }
+  }
+  const key = '"slopeSector":';
+  const at = buf.indexOf(key);
+  if (at === -1) {
+    return [];
+  }
+  let depth = 0;
+  let from = -1;
+  for (let i = at + key.length; i < buf.length; i++) {
+    const c = buf[i];
+    if (c === '[') {
+      if (depth === 0) {
+        from = i;
+      }
+      depth++;
+    } else if (c === ']') {
+      depth--;
+      if (depth === 0) {
+        try {
+          return JSON.parse(buf.slice(from, i + 1));
+        } catch {
+          return [];
+        }
+      }
+    }
+  }
+  return [];
+}
+
+// Each sector carries a slopeList of runs; info.name is the display name,
+// info.difficulty the level token, and `open` a JSON boolean. String(open)
+// ('true'/'false') is coerced to open/closed by the shared trail collector.
+export default function parse(dom) {
+  const rows = [];
+  for (const sector of slopeSectors(dom)) {
+    for (const slope of sector.slopeList ?? []) {
+      const info = slope.info ?? {};
+      if (!info.name) {
+        continue;
+      }
+      rows.push({
+        name: info.name,
+        status: String(slope.open),
+        level: LEVELS[info.difficulty]
+      });
+    }
+  }
+  return rows;
+}
diff --git a/lib/resorts/mont-edouard/index.js b/lib/resorts/mont-edouard/index.js
new file mode 100644
index 00000000..a88e2ce9
--- /dev/null
+++ b/lib/resorts/mont-edouard/index.js
@@ -0,0 +1,47 @@
+import select from '../../select.js';
+import { allText } from '../../tools/domutil.js';
+
+// Mont Édouard's lift status is a hand-edited Squarespace code block on
+// /info-remontee: `div.lift-box-single` per lift, with the lift name in <h2>.
+// Staff comment out the inactive `<p><strong>` status lines (htmlparser2 drops
+// comment text), leaving exactly one active status per real lift. A third box
+// whose <h2> reads "LÉGENDE / CHART" is the legend and is excluded.
+//
+// The status vocabulary is bilingual FR/EN and unknown to coerce, so it is
+// mapped explicitly here:
+//   Opération normale - Regular operation              -> open
+//   Opération par moteur auxiliaire - ... secondary motor -> open
+//   Arrêt temporaire - Temporary stop                  -> hold
+//   Évacuation manuelle - Manual evacuation            -> closed
+function liftStatus(text) {
+  const t = text.toLowerCase();
+  if (/[ée]vacuation/.test(t)) {
+    return 'closed';
+  }
+  if (/arr[êe]t|temporaire|temporary stop/.test(t)) {
+    return 'hold';
+  }
+  if (/normale|auxiliaire|moteur|secondary|regular operation/.test(t)) {
+    return 'open';
+  }
+  return 'scheduled';
+}
+
+export default function parse(dom) {
+  const lifts = {};
+  for (const box of select(dom, '.lift-box-single')) {
+    const name = allText(select(box, 'h2')[0] ?? box)
+      .replace(/\s+/g, ' ')
+      .trim();
+    if (!name || /l[ée]gende|chart/i.test(name)) {
+      continue;
+    }
+    const status = select(box, 'p strong')
+      .map(s => allText(s).replace(/\s+/g, ' ').trim())
+      .find(Boolean);
+    if (status) {
+      lifts[name] = liftStatus(status);
+    }
+  }
+  return lifts;
+}
