+document.addEventListener("DOMContentLoaded", function () {
+
+    /* 1. Trouver où insérer le language switcher */
+    const header = document.querySelector('.header-actions, .header-buttons, .Header-actions');
+    if (!header) return;
+
+    /* 2. Créer le switcher dynamiquement */
+    const langDiv = document.createElement('div');
+    langDiv.className = 'lang-switch';
+    langDiv.innerHTML = `
+        <a href="/fr/hiver-au-mont-edouard" class="lang-fr">FR</a> |
+        <a href="/en/winter-at-mount-edward" class="lang-en">EN</a>
+    `;
+
+    header.appendChild(langDiv);
+
+    /* 3. Détecter la langue active */
+    let lang = window.location.pathname.startsWith("/en/") ? "en" : "fr";
+
+    /* 4. Cacher les liens du mauvais menu */
+    document.querySelectorAll("nav a[href]").forEach(a => {
+        let href = a.getAttribute("href") || "";
+        if (href.startsWith("/fr/") || href.startsWith("/en/")) {
+            if (!href.startsWith("/" + lang + "/")) {
+                a.closest("li, .header-nav-item, .nav-item, .folder, .collection")?.remove();
+            }
+        }
+    });
+
+    /* 5. Mettre en évidence la langue active */
+    document.querySelectorAll(".lang-switch a").forEach(el => {
+        if (el.classList.contains("lang-" + lang)) {
+            el.style.fontWeight = "700";
+        }
+    });
+
+});
