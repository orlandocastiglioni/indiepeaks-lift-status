new file mode 100644
index 00000000..39d090a4
--- /dev/null
+++ b/test/resorts/caberfae-peaks-trails.js
@@ -0,0 +1,33 @@
+import trails from '../trails/index.js';
+
+// winter 2026-02-06 snapshot of https://caberfaepeaks.com/snow-report/
+// page stats read 'SLOPES OPEN - 27/27'; difficulty is not published on the page
+trails('caberfae-peaks', [
+  { name: 'SMILING IRISHMEN', status: 'open' },
+  { name: 'SHELTER', status: 'open' },
+  { name: 'EASY STREET', status: 'open' },
+  { name: 'HOT DOG', status: 'open' },
+  { name: 'SKI SHOP', status: 'open' },
+  { name: 'BUBBLE GUM', status: 'open' },
+  { name: 'BB BOULEVARD', status: 'open' },
+  { name: 'CANYON', status: 'open' },
+  { name: 'FUNNEL CAKE', status: 'open' },
+  { name: 'CHARLIE', status: 'open' },
+  { name: 'LIBERTY', status: 'open' },
+  { name: 'JENKINS', status: 'open' },
+  { name: 'STARKEY', status: 'open' },
+  { name: 'Number One', status: 'open' },
+  { name: 'RW', status: 'open' },
+  { name: 'NORTH PEAK TRAIL', status: 'open' },
+  { name: 'OLYMPIA', status: 'open' },
+  { name: 'GG’S RIDE', status: 'open' },
+  { name: 'BULLET', status: 'open' },
+  { name: 'LIFT LINE', status: 'open' },
+  { name: 'SOUTH PEAK TRAIL', status: 'open' },
+  { name: 'STAGSHEAD BOWL', status: 'open' },
+  { name: 'HOLMBERG GLADE', status: 'open' },
+  { name: 'NOTCH', status: 'open' },
+  { name: 'SLOT', status: 'open' },
+  { name: 'BACKCOUNTRY TERRAIN', status: 'open' },
+  { name: 'I-75', status: 'open' }
+]);
