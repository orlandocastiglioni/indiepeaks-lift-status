diff --git a/lib/resorts/mthood/index.js b/lib/resorts/mthood/index.js
index 0aa54fff..9cebc314 100644
--- a/lib/resorts/mthood/index.js
+++ b/lib/resorts/mthood/index.js
@@ -1,18 +1,25 @@
 import coerce from '../../tools/coerce.js';
 
-// lumiplan-style POI feed behind the mountain-report page; items carry
-// types (LIFT vs SECTOR groupers) and OPEN/CLOSED/FORECAST in
-// openingStatusCompl. Off season the feed returns sector stubs only.
+// lumiplan-style POI feed behind the mountain-report page: data[] holds
+// SECTOR objects whose lifts[] carry the SKI_LIFT entries with
+// OPEN/CLOSED/FORECAST in openingStatusCompl; Access Gates style sectors
+// nest more sectors under children[]. Off season the feed returns sector
+// stubs only (no lifts arrays).
 export default function parse(data = {}) {
   const liftStatus = {};
-  for (const item of data.data ?? []) {
-    if (!item.types?.includes('LIFT')) {
-      continue;
-    }
-    const status = item.openingStatusCompl ?? item.openingStatus;
-    if (item.name && status) {
-      liftStatus[item.name.trim()] = coerce(status);
+
+  function walk(sectors) {
+    for (const sector of sectors ?? []) {
+      for (const lift of sector.lifts ?? []) {
+        const status = lift.openingStatusCompl ?? lift.openingStatus;
+        if (lift.name && status) {
+          liftStatus[lift.name.trim()] = coerce(status);
+        }
+      }
+      walk(sector.children);
     }
   }
+
+  walk(data.data);
   return liftStatus;
 }
