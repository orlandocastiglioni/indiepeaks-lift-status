diff --git a/lib/resorts/palcall-tsumagoi/status.js b/lib/resorts/palcall-tsumagoi/status.js
new file mode 100644
index 00000000..c89bcd7e
--- /dev/null
+++ b/lib/resorts/palcall-tsumagoi/status.js
@@ -0,0 +1,19 @@
+// shared status translation for the condition tables; the raw page carries
+// Japanese vocabulary (plus OPEN/CLOSE for the parks) with stray zero-width
+// spaces, but an on-page script rewrites it to English after page load and
+// FlareSolverr hands us that post-JS DOM, so both vocabularies must map:
+// 運行中->Operating, 減速運転->Operation Slowed, 待機調査->Temporarily
+// Suspended, 運休->Closed, 整備中->Maintenance, 造成中->Preparation
+export default function translate(text = '') {
+  const t = text.replace(/[\u200B\s]+/g, '');
+  if (/運行中|減速運転|営業中|OPEN|Operating|OperationSlowed/i.test(t)) {
+    return 'open';
+  }
+  if (/待機調査|TemporarilySuspended/i.test(t)) {
+    return 'hold';
+  }
+  if (/運休|運行終了|整備中|造成中|CLOSE|Maintenance|Preparation/i.test(t)) {
+    return 'closed';
+  }
+  return t;
+}
diff --git a/lib/resorts/palcall-tsumagoi/trails.js b/lib/resorts/palcall-tsumagoi/trails.js
new file mode 100644
index 00000000..d729b0a0
--- /dev/null
+++ b/lib/resorts/palcall-tsumagoi/trails.js
@@ -0,0 +1,16 @@
+import select from '../../select.js';
+import { findText } from '../../tools/domutil.js';
+import translate from './status.js';
+
+// the only structured per-trail data the resort publishes is the terrain
+// park table in the same condition block the lifts come from
+export default {
+  selector: '.condition-park table tr',
+  parse: row => {
+    const name = findText(select(row.children, 'th')[0]);
+    const state = findText(select(row.children, 'td')[0]);
+    if (name && state) {
+      return { name, status: translate(state), level: 'terrainPark' };
+    }
+  }
+};
