 lib/resorts/loveland/index.js      |  22 +-
 lib/resorts/loveland/resort.json   |   1 +
 lib/resorts/loveland/trails.js     |  37 +++
 test/resorts/example/loveland.html | 387 +++++++++++++----------
 test/resorts/loveland-trails.js    | 484 +++++++++++++++++++++++++++++
 test/resorts/loveland.js           |  18 +-
 6 files changed, 771 insertions(+), 178 deletions(-)
 create mode 100644 lib/resorts/loveland/trails.js
 create mode 100644 test/resorts/loveland-trails.js

diff --git a/lib/resorts/loveland/index.js b/lib/resorts/loveland/index.js
index a9246c76..47b61a3c 100644
--- a/lib/resorts/loveland/index.js
+++ b/lib/resorts/loveland/index.js
@@ -1,12 +1,28 @@
 import { findText } from '../../tools/domutil.js';
 
+// table captions read 'NAME - STATUS'; the status can be a multi-word phrase
+// ('CLOSED UNTIL FURTHER NOTICE') so split on the first ' - ' only and reduce
+// anything starting with OPEN/CLOSED to tokens coerce knows
 export default {
   selector: '.tablepress-table-name',
   parse(node) {
-    const [name, status] = findText(node).split('-');
+    const [, name, status] = findText(node)?.match(/^(.+?)\s+-\s+(.+)$/) ?? [];
+    if (!name) {
+      return;
+    }
     return {
-      name: name,
-      status: status
+      name,
+      status: normalize(status)
     };
   }
 };
+
+function normalize(status) {
+  if (/^closed\b/i.test(status)) {
+    return 'closed';
+  }
+  if (/^open\b/i.test(status)) {
+    return 'open';
+  }
+  return status;
+}
