From c5b65f62ac6e96a2f73ea84c133e4beddf44ecc1 Mon Sep 17 00:00:00 2001
From: Orlando Castiglioni <orlando@orlandocc.me>
Date: Sun, 2 Aug 2026 17:20:12 -0400
Subject: resort: glencoe - fix trails - malformed rows recovered, red graded
 as black

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 lib/resorts/glencoe/trails.js     |  52 +++--
 test/resorts/example/glencoe.html | 314 +++++++++++++++++++++++-------
 test/resorts/glencoe-trails.js    |  54 +++--
 test/resorts/glencoe.js           |  12 +-
 4 files changed, 322 insertions(+), 110 deletions(-)

diff --git a/lib/resorts/glencoe/trails.js b/lib/resorts/glencoe/trails.js
index bb587fe5..76369ae8 100644
--- a/lib/resorts/glencoe/trails.js
+++ b/lib/resorts/glencoe/trails.js
@@ -2,23 +2,43 @@ import select from '../../select.js';
 import { findText } from '../../tools/domutil.js';
 import status from './status.js';
 
-// runs list rows: name td + td with "Difficulty:<span>green</span>" and a status image
-export default {
-  selector: 'table tr',
-  parse: row => {
-    const tds = row.children.filter(c => c.name === 'td');
-    if (tds.length !== 2) {
-      return;
-    }
-    const div = select(tds[1].children, 'div')[0];
-    if (!/Difficulty:/.test(findText(div) ?? '')) {
-      return;
+// UK runs use a red grade that liftie's global level map does not know;
+// map it locally (red sits between blue and black, black by local convention)
+function level(str) {
+  if (str === 'red') {
+    return 'black';
+  }
+  return str;
+}
+
+// Runs Status rows: name td + td with "Difficulty:<span>green</span>" and a
+// status image (same 0/2 images as lifts). The markup is malformed: every
+// name cell is closed with a stray </th>, and several rows (Sledging Area,
+// Coire Pollach Run, Wall Crossover, Beginners Run, Old Mugs Alley) have no
+// opening <div> but a stray </div>, which makes htmlparser2's recovery close
+// the surrounding column <div> and tear those rows out of their <table>.
+// Don't rely on <tr> grouping - walk all <td>s in document order and pair
+// each "Difficulty:" cell with the closest preceding text-bearing cell.
+export default function parse(dom) {
+  const rows = [];
+  let name;
+  for (const td of select(dom, 'td')) {
+    const text = findText(td)?.trim();
+    if (!text?.startsWith('Difficulty:')) {
+      if (text) {
+        name = text;
+      }
+      continue;
     }
-    const level = findText(select(tds[1].children, 'span')[0]);
-    const img = select(tds[1].children, 'img')[0];
-    const name = findText(tds[0])?.trim();
+    const img = select(td.children, 'img')[0];
     if (name && img) {
-      return { name, status: status(img.attribs.src), level };
+      rows.push({
+        name,
+        status: status(img.attribs.src),
+        level: level(findText(select(td.children, 'span')[0])?.trim())
+      });
+      name = undefined;
     }
   }
-};
+  return rows;
+}
