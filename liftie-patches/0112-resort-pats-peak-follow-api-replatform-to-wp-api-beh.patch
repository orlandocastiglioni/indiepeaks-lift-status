   "url": {
     "host": "https://www.patspeak.com",
-    "pathname": "/Plan-Your-Visit/Snow-Report.aspx"
+    "pathname": "/the-mountain/mountain-info/snow-report/"
   },
   "api": {
-    "host": "https://services.patspeak.com",
-    "pathname": "/api/SnowReport/Status"
+    "host": "https://wp-api.patspeak.com",
+    "pathname": "/api/SnowReport/Status",
+    "via": "flaresolverr"
+  },
+  "trails": {
+    "host": "https://wp-api.patspeak.com",
+    "pathname": "/api/SnowReport/Status",
+    "json": true,
+    "via": "flaresolverr"
   },
   "tags": [
     "New Hampshire",
diff --git a/lib/resorts/pats-peak/trails.js b/lib/resorts/pats-peak/trails.js
new file mode 100644
index 00000000..09630610
--- /dev/null
+++ b/lib/resorts/pats-peak/trails.js
@@ -0,0 +1,15 @@
+// same wp-api SnowReport feed as the lifts (flaresolverr-proxied, see
+// resort.json); Trails[] carries the full 30-run roster year round:
+// { Name, Active, TrailLevel, Status: { Open } }
+//
+// TrailLevel tokens (Easiest | More Difficult | Most Difficult | Expert Only |
+// Terrain Park) all normalize in lib/trails/parse.js
+export default function parse(data) {
+  return (data.Trails ?? [])
+    .filter(trail => trail.Active)
+    .map(trail => ({
+      name: trail.Name,
+      status: trail.Status.Open ? 'open' : 'closed',
+      level: trail.TrailLevel
+    }));
+}
