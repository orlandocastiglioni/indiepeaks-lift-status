diff --git a/lib/resorts/dynaland/status.js b/lib/resorts/dynaland/status.js
index 5559df28..6afdc806 100644
--- a/lib/resorts/dynaland/status.js
+++ b/lib/resorts/dynaland/status.js
@@ -4,7 +4,8 @@ export default function status(text = '') {
   if (/^[○◯〇]/.test(t) || /運行中|営業中/.test(t)) {
     return 'open';
   }
-  if (/^[△▲]/.test(t)) {
+  if (/^[△▲]/.test(t) || /要確認/.test(t)) {
+    // 要確認 = "check with staff" - conditionally open tree run areas
     return 'hold';
   }
   if (/^[×✕✖-]/.test(t) || /運休|終了/.test(t)) {
diff --git a/lib/resorts/dynaland/trails.js b/lib/resorts/dynaland/trails.js
index 76785d2a..a655adc9 100644
--- a/lib/resorts/dynaland/trails.js
+++ b/lib/resorts/dynaland/trails.js
@@ -35,5 +35,20 @@ export default function parse(dom) {
       }
     }
   }
+  // section#park keeps its パーク名 header in a table of its own, followed by
+  // header-less single-row tables (name | glyph | comment) that the loop above
+  // never collects; モーグルコース doubles as a blue course, so skip names we
+  // already have. section#kids (sledding, indoor play, food court) is
+  // intentionally excluded.
+  const seen = new Set(rows.map(r => r.name));
+  for (const tr of select(dom, 'section#park table tr')) {
+    const cells = select(tr.children, 'td').map(findText);
+    const name = cells[0]?.trim();
+    if (!name || !cells[1] || seen.has(name)) {
+      continue;
+    }
+    seen.add(name);
+    rows.push({ name, status: status(cells[1]), level: 'terrainPark' });
+  }
   return rows;
 }
