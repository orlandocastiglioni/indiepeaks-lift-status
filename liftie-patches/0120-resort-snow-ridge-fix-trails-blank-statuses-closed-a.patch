 2 files changed, 115 insertions(+), 72 deletions(-)

diff --git a/lib/resorts/snow-ridge/trails.js b/lib/resorts/snow-ridge/trails.js
index 7ce61ed3..c392a583 100644
--- a/lib/resorts/snow-ridge/trails.js
+++ b/lib/resorts/snow-ridge/trails.js
@@ -20,12 +20,15 @@ export default function parse(dom) {
     const name = allText(tds[0])
       .replace(/^\s*\d+\.\s*/, '')
       .trim();
-    const status = findText(tds[1]);
-    if (name && status) {
+    // a blank status cell on this hand-posted report means the trail is not open
+    const status = (findText(tds[1]) ?? '').trim() || 'closed';
+    if (name) {
       rows.push({
         name,
         status,
-        level: icon.attribs.alt || icon.attribs.src.match(/icon-([a-z_]+)\.png/)?.[1]
+        // prefer the icon src: terrain park rows use icon-terrain_park.png
+        // but carry a hand-copied alt="black-diamond"
+        level: icon.attribs.src?.match(/icon-([a-z_]+)\.png/)?.[1] ?? icon.attribs.alt
       });
     }
   }
