[Unit]
Description=Liftie ski lift status server (localhost only)
Documentation=https://github.com/pirxpilot/liftie
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orlando
Group=orlando
WorkingDirectory=/home/orlando/liftie
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=LIFTIE_HOST=127.0.0.1
Environment=LIFTIE_RENDERD=http://127.0.0.1:3002
Environment=LIFTIE_RESORTS=49-degrees-north,antelope-butte,bethel-village-trails,black-jack,caledonia-nordic,kimberley-nordic,mt-washington-bc-xc,nelson-nordic,nickel-plate-nordic,sovereign-lake,telemark-nordic,whitehorse-nordic,williams-lake-xc,apex-mountain-resort,baldy-mountain-resort,cape-smokey,centre-vorlage,hockley-valley,hudson-bay-mountain,loch-lomond,marble-mountain,massif-du-sud,mont-edouard,mont-habitant,mont-rigaud,mont-sutton,mt-washington-bc,murray-ridge,shames-mountain,smokey-mountain,val-direne,vallee-bleue,berkshire-east,crystal-ridge,powderhorn,big-moose,big-white,bolton-valley,burke-mountain,caberfae-peaks,calabogie,canaan-valley,cannon,cooper-spur,castle-mountain,cataloochee,chinapeak,donner-ski-ranch,dynaland,eagle-point,echo-mountain,glencoe,granite-peak,greek-peak,hirugano-kogen,hochzeiger,hoodoo,jay-peak,king-pine,little-switzerland,loveland,lutsen-mountains,manning-park,manning-park-xc,mission-ridge,mt-abram,mt-la-crosse,mthigh,mthood,nayoro-piyashiri,nordic-mountain,okunakayama,owlshead,pats-peak,palcall-tsumagoi,pitztaler-gletscher,ragged-mountain,red-lodge-mountain,rikert,saddleback,saskadena-six,sasquatch-mountain,shawnee-mountain,ski-sawmill,skiwelt,snow-ridge,snowriver,sundown-mountain,swain,takasu-snow-park,togakushi,washigatake,waterville,west-mountain,wintergreen,winterplace,wisp
Environment="LIFTIE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
ExecStart=/usr/bin/node app.js
Restart=always
CPUQuota=200%
CPUWeight=60
RestartSec=10

# hardening — liftie only needs to read its tree and write its cache to /tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
